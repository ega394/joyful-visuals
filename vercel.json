{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/notif-cron?type=pimpinan", "schedule": "30 22 * * *" },
    { "path": "/api/notif-cron?type=pagi",     "schedule": "30 23 * * *" },
    { "path": "/api/notif-cron?type=reminder", "schedule": "55 7 * * *"  },
    { "path": "/api/notif-cron?type=ajudan",   "schedule": "0 8 * * *"   },
    { "path": "/api/notif-cron?type=pending",  "schedule": "0 8 * * *"   }
  ]
}